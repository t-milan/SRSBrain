<UserControl x:Class="Plugin.SRSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Plugin"
             mc:Ignorable="d" 
             d:DesignHeight="425" d:DesignWidth="540">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="Select Target Structrues" Margin="5">
                    <ListView ItemsSource="{Binding SelectableTargets}">
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn Header="">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding isChecked}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn DisplayMemberBinding="{Binding structure.Id}" Header="Id"/>
                                    <GridViewColumn DisplayMemberBinding="{Binding structure.DicomType}" Header="Volume Type"/>
                                    <GridViewColumn Header="Volume">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding structure.Volume, StringFormat=N2}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
                <GroupBox Grid.Column="1" Header="Field Arrangement" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!--<ComboBox Grid.Row="0" ItemsSource="{Binding Arrangements}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedArrangement}"/>-->
                        <RadioButton Grid.Row="0" Margin="5,5,5,0" 
                                     Content="Use Existing Geometry"
                                     Command="{Binding ArrangementRadioCommand}"
                                     CommandParameter="ExistButton"/>
                        <RadioButton Grid.Row="1" Margin="5,5,5,0" Content="45° Couch Kicks" IsChecked="True"
                                     Command="{Binding ArrangementRadioCommand}"
                                     CommandParameter="45degButton"/>
                        <RadioButton Grid.Row="2" Margin="5,5,5,0" Content="60° Couch Kicks"
                                     Command="{Binding ArrangementRadioCommand}"
                                     CommandParameter="60degButton"/>
                        <TabControl Grid.Row="3" Margin="2" SelectedIndex="{Binding SelectedTabIndex}">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <!--<Setter Property="Visibility" Value="Collapsed"/>-->
                                </Style>
                            </TabControl.Resources>
                            <TabItem Header="Existing">
                            </TabItem>
                            <TabItem Header="45°">
                                <Grid>
                                    <Image Source="/Resources/Head_A.png"  Stretch="Uniform" Width="200" Height="220"/>
                                    <CheckBox Margin="10,90,0,0" IsChecked="{Binding IsSelected45DegT0R}"/>
                                    <CheckBox Margin="40,35,0,0" IsChecked="{Binding IsSelected45DegT315}"/>
                                    <CheckBox Margin="94,20,0,0" IsChecked="{Binding IsSelected45DegT90}"/>
                                    <CheckBox Margin="145,35,0,0" IsChecked="{Binding IsSelected45DegT45}"/>
                                    <CheckBox Margin="170,90,0,0" IsChecked="{Binding IsSelected45DegT0L}"/>
                                </Grid>
                            </TabItem>
                            <TabItem Header="60°">
                                <Grid>
                                    <Image Source="/Resources/Head_E.png"  Stretch="Uniform" Width="200" Height="220"/>
                                    <CheckBox Margin="10,90,0,0" IsChecked="{Binding IsSelected60DegT0R}"/>
                                    <CheckBox Margin="56,25,0,0" IsChecked="{Binding IsSelected60DegT300}"/>
                                    <CheckBox Margin="130,25,0,0" IsChecked="{Binding IsSelected60DegT60}"/>
                                    <CheckBox Margin="170,90,0,0" IsChecked="{Binding IsSelected60DegT0L}"/>
                                </Grid>
                                
                            </TabItem>
                            
                        </TabControl>
                        <CheckBox Content="Automate Isocentre Placement" IsChecked="{Binding AutomateIso, Mode=TwoWay}" Grid.Row="4" Margin="5"/>
                        <CheckBox Content="Optimise Collimator Rotation" IsChecked="{Binding OptimiseCol, Mode=TwoWay}" Grid.Row="5" Margin="5"/>
                    </Grid>
                </GroupBox >
                
            </Grid>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="0.2*"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Margin="5" Value="{Binding Progress}"/>
            <Button Grid.Column="1" Content="Calculate" Margin="5" Command="{Binding CalculateOptimalCollimatorCommand}" />
        </Grid>
    </Grid>
</UserControl>
